{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "outputDir": {
      "default": "output",
      "type": "string",
      "minLength": 1
    },
    "keepRuns": {
      "default": 20,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "trace": {
      "default": "on-failure",
      "type": "string",
      "enum": [
        "on-failure",
        "off"
      ]
    },
    "profilesDir": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "version",
    "outputDir",
    "keepRuns",
    "trace",
    "profilesDir"
  ],
  "additionalProperties": false
}
