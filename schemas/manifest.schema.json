{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "site": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "params": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "const": "string"
              },
              "default": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "required",
              "description",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "const": "number"
              },
              "default": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "required",
              "description",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "const": "boolean"
              },
              "default": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "required",
              "description",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "const": "enum"
              },
              "options": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "default": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "required",
              "description",
              "type",
              "options"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "csv",
            "json",
            "none"
          ]
        }
      },
      "required": [
        "format"
      ],
      "additionalProperties": false
    },
    "browser": {
      "default": {
        "headless": null
      },
      "type": "object",
      "properties": {
        "headless": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "headless"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "name",
    "description",
    "site",
    "params",
    "output",
    "browser"
  ],
  "additionalProperties": false
}
